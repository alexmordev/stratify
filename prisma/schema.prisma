generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Meta {
  id         String     @id @default(cuid())
  title      String     @db.Text
  title_en   String     @db.Text
  why        String     @db.Text
  why_en     String     @db.Text
  success    String     @db.Text
  success_en String     @db.Text
  horizon    String     @db.Text
  horizon_en String     @db.Text
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  objetivos  Objetivo[]
}

model Objetivo {
  id         String  @id @default(cuid())
  metaId     String
  meta       Meta    @relation(fields: [metaId], references: [id], onDelete: Cascade)
  title      String  @db.Text
  title_en   String  @db.Text
  color      String  @default("sand")
  weeklyLoad Int     @default(1)
  done       Int     @default(0)
  thisWeek   Boolean @default(false)
  tareas     Tarea[]
}

model Tarea {
  id        String   @id @default(cuid())
  objId     String
  objetivo  Objetivo @relation(fields: [objId], references: [id], onDelete: Cascade)
  title     String
  title_en  String
  day       Int
  start     Float
  dur       Float
  done      Boolean  @default(false)
  subtasks  Json?
  createdAt DateTime @default(now())
}
